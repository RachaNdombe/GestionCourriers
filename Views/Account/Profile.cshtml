@model ProfileViewModel
@{
    ViewData["Title"] = "Mon Profil";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <h4>Informations personnelles</h4>
            </div>
            <div class="card-body">
                <form id="profile-form" method="post" asp-action="UpdateProfile">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="form-group">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" disabled />
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Prenom">Prénom</label>
                        <input asp-for="Prenom" class="form-control" />
                        <span asp-validation-for="Prenom" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Nom">Nom</label>
                        <input asp-for="Nom" class="form-control" />
                        <span asp-validation-for="Nom" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="ServiceNom">Service</label>
                        <input asp-for="ServiceNom" class="form-control" disabled />
                    </div>
                    
                    <button type="submit" class="btn btn-primary mt-3">Mettre à jour</button>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h4>Sécurité</h4>
            </div>
            <div class="card-body">
                <form id="password-form" asp-action="ChangePassword">
                    <div class="form-group">
                        <label for="CurrentPassword">Mot de passe actuel</label>
                        <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control" required />
                    </div>
                    
                    <div class="form-group">
                        <label for="NewPassword">Nouveau mot de passe</label>
                        <input type="password" id="NewPassword" name="NewPassword" class="form-control" required />
                    </div>
                    
                    <div class="form-group">
                        <label for="ConfirmPassword">Confirmer le mot de passe</label>
                        <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" required />
                    </div>
                    
                    <button type="submit" class="btn btn-primary mt-3">Changer le mot de passe</button>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h4>Authentification à deux facteurs</h4>
            </div>
            <div class="card-body">
                @if (Model.IsTwoFactorEnabled)
                {
                    <p class="text-success">2FA est activée</p>
                    <button id="disable2fa" class="btn btn-danger">Désactiver 2FA</button>
                }
                else
                {
                    <p>2FA n'est pas activée</p>
                    <button id="enable2fa" class="btn btn-primary">Activer 2FA</button>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h4>Sessions actives</h4>
            </div>
            <div class="card-body">
                <div id="active-sessions">
                    @foreach (var session in Model.ActiveSessionsModel.Sessions)
                    {
                        <div class="session-item @(session.IsCurrentSession ? "current-session" : "")">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@(session.IsCurrentSession ? "Session actuelle" : "Autre session")</strong>
                                    <p class="mb-0">IP: @session.IpAddress</p>
                                    <small>Dernière activité: @session.LastActivity.ToString("g")</small>
                                </div>
                                @if (!session.IsCurrentSession)
                                {
                                    <button class="btn btn-danger btn-sm disconnect-session" data-session-id="@session.Id">
                                        Déconnecter
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (Model.ActiveSessionsModel.Sessions.Count > 1)
                {
                    <button id="disconnect-all" class="btn btn-warning mt-3">Déconnecter toutes les autres sessions</button>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h4>Historique des connexions</h4>
            </div>
            <div class="card-body">
                <div id="login-logs">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>IP</th>
                                    <th>Statut</th>
                                    <th>2FA</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in Model.LoginLogsModel.Logs)
                                {
                                    <tr>
                                        <td>@log.LoginTime.ToString("g")</td>
                                        <td>@log.IpAddress</td>
                                        <td>
                                            @if (log.IsSuccessful)
                                            {
                                                <span class="text-success">Réussi</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger" title="@log.FailureReason">Échec</span>
                                            }
                                        </td>
                                        <td>@(log.IsTwoFactorUsed ? "Oui" : "Non")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    
    <script>
        $(document).ready(function() {
            // Gestion du changement de mot de passe
            $("#password-form").on("submit", function(e) {
                e.preventDefault();
                $.post("/Account/ChangePassword", $(this).serialize())
                    .done(function(response) {
                        if (response.success) {
                            alert("Mot de passe modifié avec succès");
                            $("#password-form")[0].reset();
                        } else {
                            alert(response.message);
                        }
                    });
            });

            // Gestion des sessions
            $(".disconnect-session").click(function() {
                var sessionId = $(this).data("session-id");
                $.post("/Account/DisconnectSession", { sessionId: sessionId })
                    .done(function(response) {
                        if (response.success) {
                            location.reload();
                        }
                    });
            });

            $("#disconnect-all").click(function() {
                $.post("/Account/DisconnectAllOtherSessions")
                    .done(function(response) {
                        if (response.success) {
                            location.reload();
                        }
                    });
            });

            // Gestion 2FA
            $("#enable2fa").click(function() {
                location.href = "/Account/TwoFactorAuthentication";
            });

            $("#disable2fa").click(function() {
                if (confirm("Êtes-vous sûr de vouloir désactiver l'authentification à deux facteurs ?")) {
                    $.post("/Account/DisableTwoFactorAuth")
                        .done(function(response) {
                            if (response.success) {
                                location.reload();
                            }
                        });
                }
            });
        });
    </script>
}