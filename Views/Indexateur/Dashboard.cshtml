@model JconsultGC.Models.IndexateurDashboardViewModel

@{
    ViewData["Title"] = "Tableau de bord Indexateur";
}

<div class="container mt-4">
    <h2>Tableau de bord Indexateur</h2>

    <div class="row mt-4">
        <!-- Stats Cards -->
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Total indexés</h5>
                    <a href="@Url.Action("Index", "CourriersEntrant")" class="text-white text-decoration-none">
                        <p class="card-text display-4">@Model.TotalCourriersIndexes</p>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h5 class="card-title">Très prioritaires</h5>
                    <p class="card-text display-4">@Model.CourriersTresPrioritaires</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <h5 class="card-title">En attente</h5>
                    <p class="card-text display-4">@Model.CourriersEnAttente</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Actions aujourd'hui</h5>
                    <p class="card-text display-4">@Model.ActionsAujourdhui</p>
                </div>
            </div>
        </div>
        <div class="col-md-3" style="margin-top: 50px;">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">Courriers signés</h5>
                    <a href="#courriersSignes" class="text-white text-decoration-none">
                        <p class="card-text display-4">@Model.CourriersSignes</p>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <!-- Recent Actions (Today only) -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Actions d'aujourd'hui</h5>
                    <small class="text-muted">@DateTime.Today.ToString("dd/MM/yyyy")</small>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @if (Model.RecentActions != null && Model.RecentActions.Any())
                        {
                            @foreach (var action in Model.RecentActions)
                            {
                                <a href="@Url.Action("Details", "CourriersEntrant", new { id = action.CourrierId })" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@action.Action</h6>
                                        <small>@action.Timestamp.ToString("HH:mm")</small>
                                    </div>
                                    <p class="mb-1">@action.Note</p>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="list-group-item text-center text-muted">
                                Aucune action aujourd'hui
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Courriers récents créés par cet indexateur -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Mes courriers récents</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @if (Model.RecentCourriers != null && Model.RecentCourriers.Any())
                        {
                            @foreach (var courrier in Model.RecentCourriers)
                            {
                                <a href="@Url.Action("Details", "CourriersEntrant", new { id = courrier.Id })" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@courrier.ReferenceNumero</h6>
                                        <small>@courrier.DateEnregistrement.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <p class="mb-1">@courrier.Objet</p>
                                    <small>
                                        <span class="badge @GetStatusBadgeClass(courrier.Statut)">@courrier.Statut</span>
                                        - @(courrier.CategorieCourrier?.Nom ?? "Non catégorisé")
                                    </small>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="list-group-item text-center text-muted">
                                Aucun courrier créé
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Courriers à valider -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Courriers en attente de validation</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @if (Model.CourriersAValider != null && Model.CourriersAValider.Any())
                        {
                            @foreach (var courrier in Model.CourriersAValider)
                            {
                                <a href="@Url.Action("Details", "CourriersEntrant", new { id = courrier.Id })" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@courrier.ReferenceNumero</h6>
                                        <small>@courrier.DateEnregistrement.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <p class="mb-1">@courrier.Objet</p>
                                    <small>@(courrier.CategorieCourrier?.Nom ?? "Non catégorisé") - @courrier.Priorite</small>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="list-group-item text-center text-muted">
                                Aucun courrier à valider
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Courriers signés -->
    <div class="row mt-4" id="courriersSignes">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>Courriers signés</h5>
                    <small class="text-muted">Courriers signés par les services, prêts à être archivés</small>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @if (Model.CourriersSignesList != null && Model.CourriersSignesList.Any())
                        {
                            @foreach (var courrier in Model.CourriersSignesList)
                            {
                                <a href="@Url.Action("Details", "CourriersEntrant", new { id = courrier.Id })" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <div>
                                            <h6 class="mb-1">@courrier.ReferenceNumero</h6>
                                            <p class="mb-1">@courrier.Objet</p>
                                            <small>
                                                <span class="badge @GetStatusBadgeClass(courrier.Statut)">@courrier.Statut</span>
                                                - @(courrier.CategorieCourrier?.Nom ?? "Non catégorisé")
                                            </small>
                                        </div>
                                        <div>
                                            <small class="text-muted">En attente d'archivage</small>
                                        </div>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="list-group-item text-center text-muted">
                                Aucun courrier signé
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <!-- Actions rapides -->
        <div class="col-12">
            <div class="d-flex gap-2">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Nouveau courrier
                </a>
                @if (User.IsInRole("Viseur"))
                {
                    <a asp-action="Dashboard" asp-controller="Viseur" class="btn btn-warning">
                        <i class="bi bi-check-circle"></i> Tableau de bord Viseur
                    </a>
                }
                <button type="button" class="btn btn-outline-primary" onclick="refreshDashboard()">
                    <i class="bi bi-arrow-clockwise"></i> Actualiser
                </button>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string statut)
    {
        return statut?.ToLower() switch
        {
            "a valider" => "bg-warning",
            "validé" => "bg-success",
            "rejeté" => "bg-danger",
            "archivé" => "bg-secondary",
            "a saisir" => "bg-info",
            "signé" => "bg-primary",
            _ => "bg-light text-dark"
        };
    }
}

@section Scripts {
    <script>
        // Actualiser après l'enregistrement d'un courrier
        document.addEventListener('courrierSaved', function() {
            location.reload();
        });

        // Actualiser manuellement
        function refreshDashboard() {
            location.reload();
        }
    </script>
}
