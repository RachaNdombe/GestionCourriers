@section Scripts {
    <script>
        // Initialisation des Select2 pour les pays
        $(document).ready(function() {
            $('#paysPersonne').select2({
                placeholder: "Rechercher un pays d'Afrique",
                allowClear: true
            });
            
            $('#paysSociete').select2({
                placeholder: "Rechercher un pays d'Afrique",
                allowClear: true
            });

            // Gestion de l'affichage du dossier sélectionné (optionnel)
            const dossierSelect = document.getElementById('dossierClassementSelect');
            const dossierDisplay = document.getElementById('selectedDossierDisplay');
            const dossierNom = document.getElementById('dossierNom');
            const dossierDetails = document.getElementById('dossierDetails');

            if (dossierSelect && dossierDisplay) {
                dossierSelect.addEventListener('change', function() {
                    const selectedOption = this.options[this.selectedIndex];
                    
                    if (this.value) {
                        dossierNom.textContent = selectedOption.text;
                        dossierDetails.textContent = `Dossier ID: ${this.value}`;
                        dossierDisplay.style.display = 'block';
                    } else {
                        dossierDisplay.style.display = 'none';
                    }
                });

                // Initialiser l'affichage si un dossier est déjà sélectionné
                if (dossierSelect.value) {
                    const selectedOption = dossierSelect.options[dossierSelect.selectedIndex];
                    dossierNom.textContent = selectedOption.text;
                    dossierDetails.textContent = `Dossier ID: ${dossierSelect.value}`;
                    dossierDisplay.style.display = 'block';
                }
            }

            // Gestion des événements submit pour les formulaires Personne et Société
            const personneForm = document.getElementById('personneForm');
            const societeForm = document.getElementById('societeForm');

            if (personneForm) {
                personneForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    console.log('Formulaire Personne soumis');
                    
                    if (!this.checkValidity()) {
                        e.stopPropagation();
                        this.classList.add('was-validated');
                        return;
                    }

                    const formData = new FormData(this);
                    console.log('FormData Personne créé:', formData);
                    
                    if (!formData.get('nom')) {
                        alert('Le nom est obligatoire');
                        return;
                    }

                    const data = {
                        raisonSociale: 'Personne',
                        nom: formData.get('nom'),
                        civilite: formData.get('civilite'),
                        email: formData.get('email'),
                        contact1: formData.get('contact1'),
                        adresse: formData.get('adresse'),
                        ville: formData.get('ville'),
                        codePostal: formData.get('codePostal'),
                        pays: formData.get('pays')
                    };

                    console.log('Données Personne à envoyer:', data);
                    saveCorrespondant(data);
                });
            }

            if (societeForm) {
                societeForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    console.log('Formulaire Société soumis');
                    
                    if (!this.checkValidity()) {
                        e.stopPropagation();
                        this.classList.add('was-validated');
                        return;
                    }

                    const formData = new FormData(this);
                    console.log('FormData Société créé:', formData);
                    
                    if (!formData.get('nomOrg')) {
                        alert('Le nom de la société est obligatoire');
                        return;
                    }

                    const data = {
                        raisonSociale: 'Organisation',
                        nom: formData.get('nomOrg'),
                        email: formData.get('email'),
                        contact1: formData.get('contact1'),
                        adresse: formData.get('adresse'),
                        ville: formData.get('ville'),
                        codePostal: formData.get('codePostal'),
                        pays: formData.get('pays')
                    };

                    console.log('Données Société à envoyer:', data);
                    saveCorrespondant(data);
                });
            }
        });

        // Gestion du nouveau mode d'envoi
        document.getElementById('btnAddModeEnvoi').addEventListener('click', function() {
            const modeEnvoiModal = new bootstrap.Modal(document.getElementById('modeEnvoiModal'));
            modeEnvoiModal.show();
        });

        // Gestion du nouveau système d'expéditeur
        document.getElementById('btnNewCorrespondant').addEventListener('click', function() {
            const typeModal = new bootstrap.Modal(document.getElementById('correspondantTypeModal'));
            typeModal.show();
        });

        document.getElementById('btnPersonne').addEventListener('click', function() {
            const typeModal = bootstrap.Modal.getInstance(document.getElementById('correspondantTypeModal'));
            typeModal.hide();
            
            const personneModal = new bootstrap.Modal(document.getElementById('personneModal'));
            personneModal.show();
        });

        document.getElementById('btnSociete').addEventListener('click', function() {
            const typeModal = bootstrap.Modal.getInstance(document.getElementById('correspondantTypeModal'));
            typeModal.hide();
            
            const societeModal = new bootstrap.Modal(document.getElementById('societeModal'));
            societeModal.show();
        });


        function saveCorrespondant(data) {
            console.log('Saving correspondant:', data);
            
            fetch('/Correspondants/CreateAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(data)
            })
            .then(response => {
                console.log('Response status:', response.status);
                console.log('Response headers:', response.headers);
                
                if (!response.ok) {
                    // Try to get error message from response
                    return response.text().then(text => {
                        console.log('Response text:', text);
                        throw new Error(`HTTP error! status: ${response.status}, response: ${text}`);
                    });
                }
                return response.json();
            })
            .then(result => {
                console.log('Response result:', result);
                if (result.success) {
                    // Ajouter le nouveau correspondant à la liste déroulante
                    const select = document.getElementById('CorrespondantId');
                    if (select) {
                        const option = new Option(result.nom, result.id, false, true);
                        select.appendChild(option);
                    }
                    
                    // Fermer les modaux et réinitialiser les formulaires
                    const personneModalElement = document.getElementById('personneModal');
                    const societeModalElement = document.getElementById('societeModal');
                    
                    if (personneModalElement) {
                        const personneModal = bootstrap.Modal.getInstance(personneModalElement);
                        if (personneModal) personneModal.hide();
                        document.getElementById('personneForm').reset();
                        document.getElementById('personneForm').classList.remove('was-validated');
                    }
                    
                    if (societeModalElement) {
                        const societeModal = bootstrap.Modal.getInstance(societeModalElement);
                        if (societeModal) societeModal.hide();
                        document.getElementById('societeForm').reset();
                        document.getElementById('societeForm').classList.remove('was-validated');
                    }

                    // Notification
                    alert('Expéditeur créé avec succès');
                } else {
                    alert('Erreur: ' + (result.message || 'Erreur inconnue'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Erreur lors de la création de l\'expéditeur: ' + error.message);
            });
        }

        // Gestion du formulaire mode d'envoi
        const modeEnvoiForm = document.getElementById('modeEnvoiForm');
        if (modeEnvoiForm) {
            modeEnvoiForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                if (!this.checkValidity()) {
                    e.stopPropagation();
                    this.classList.add('was-validated');
                    return;
                }

                const formData = new FormData(this);
                const data = {
                    code: formData.get('Code'),
                    libelle: formData.get('Libelle'),
                    description: formData.get('Description'),
                    actif: formData.get('Actif') === 'on',
                    ordre: parseInt(formData.get('Ordre')) || 0
                };

                saveModeEnvoi(data);
            });
        }

        function saveModeEnvoi(data) {
            fetch('/ModesEnvoi/CreateAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(data)
            })
            .then(response => {
                if (!response.ok) {
                    return response.text().then(text => {
                        throw new Error(`HTTP error! status: ${response.status}, response: ${text}`);
                    });
                }
                return response.json();
            })
            .then(result => {
                if (result.success) {
                    // Ajouter le nouveau mode d'envoi à la liste déroulante
                    const select = document.getElementById('modeEnvoiSelect');
                    if (select) {
                        const option = new Option(result.libelle, result.id, false, true);
                        select.appendChild(option);
                    }
                    
                    // Fermer le modal et réinitialiser le formulaire
                    const modeEnvoiModalElement = document.getElementById('modeEnvoiModal');
                    if (modeEnvoiModalElement) {
                        const modeEnvoiModal = bootstrap.Modal.getInstance(modeEnvoiModalElement);
                        if (modeEnvoiModal) modeEnvoiModal.hide();
                        document.getElementById('modeEnvoiForm').reset();
                        document.getElementById('modeEnvoiForm').classList.remove('was-validated');
                    }

                    // Notification
                    alert('Mode d\'envoi créé avec succès');
                } else {
                    alert('Erreur: ' + (result.message || 'Erreur inconnue'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Erreur lors de la création du mode d\'envoi: ' + error.message);
            });
        }

        // Focus the file input when user clicks the Select button
        document.getElementById('btnSelect').addEventListener('click', function () {
            document.querySelector('input[type=file][name=Attachments]').click();
        });

        document.getElementById('btnScan').addEventListener('click', function () {
            alert('Fonction de scan non-implémentée dans le navigateur. Connectez un scanner ou utilisez l\'application mobile pour scanner et uploader les fichiers.');
        });

        const fileInput = document.getElementById('fileInput');
        const fileViewerInput = document.getElementById('fileViewerInput');
        const btnViewFile = document.getElementById('btnViewFile');
        const fileViewedCheckbox = document.getElementById('fileViewedCheckbox');
        const visualizedCheckbox = document.getElementById('visualizedCheckbox');
        const submitBtn = document.getElementById('submitBtn');

        // Gestion de la sélection de fichier pour visualisation
        fileViewerInput.addEventListener('change', function (e) {
            const files = Array.from(fileViewerInput.files || []);
            const filePreviewArea = document.getElementById('filePreviewArea');
            const fileInfo = document.getElementById('fileInfo');
            const fileContent = document.getElementById('fileContent');
            
            if (files.length === 0) {
                filePreviewArea.style.display = 'none';
                fileViewedCheckbox.checked = false;
                return;
            }

            const file = files[0];
            
            // Afficher les informations du fichier
            fileInfo.innerHTML = `
                <strong>Nom:</strong> ${file.name}<br>
                <strong>Taille:</strong> ${(file.size / 1024).toFixed(2)} KB<br>
                <strong>Type:</strong> ${file.type || 'Non spécifié'}
            `;
            
            // Afficher le contenu selon le type de fichier
            fileContent.innerHTML = '';
            
            if (file.type.startsWith('image/')) {
                // Afficher l'image
                const reader = new FileReader();
                reader.onload = function(e) {
                    fileContent.innerHTML = `<img src="${e.target.result}" class="img-fluid" style="max-height: 300px;" alt="Aperçu de l'image">`;
                };
                reader.readAsDataURL(file);
            } else if (file.type === 'application/pdf') {
                // Afficher un aperçu PDF
                const reader = new FileReader();
                reader.onload = function(e) {
                    fileContent.innerHTML = `
                        <div class="alert alert-info">
                            <i class="bi bi-file-earmark-pdf"></i> Fichier PDF sélectionné
                            <br><small>Le fichier sera téléchargé lors de l'enregistrement</small>
                        </div>
                        <iframe src="${e.target.result}" width="100%" height="400" style="border: 1px solid #ddd;"></iframe>
                    `;
                };
                reader.readAsDataURL(file);
            } else if (file.type.includes('text/') || file.name.endsWith('.txt')) {
                // Afficher le contenu texte
                const reader = new FileReader();
                reader.onload = function(e) {
                    fileContent.innerHTML = `<pre class="bg-white p-2 border rounded">${e.target.result}</pre>`;
                };
                reader.readAsText(file);
            } else {
                // Pour les autres types de fichiers
                fileContent.innerHTML = `
                    <div class="alert alert-warning">
                        <i class="bi bi-file-earmark"></i> Type de fichier: ${file.type || 'Inconnu'}
                        <br><small>Le fichier sera téléchargé lors de l'enregistrement</small>
                    </div>
                `;
            }
            
            // Afficher la zone d'aperçu
            filePreviewArea.style.display = 'block';
            
            // Cocher automatiquement la case de visualisation
            fileViewedCheckbox.checked = true;
        });

        // When files are selected for attachments
        fileInput.addEventListener('change', function (e) {
            const files = Array.from(fileInput.files || []);
            console.log('Fichiers sélectionnés:', files.length);
        });

        // Gestion du bouton Sélectionner dossier
        document.getElementById('btnSelectDossier').addEventListener('click', function() {
            // Simuler un clic sur le sélecteur de dossier
            document.getElementById('dossierClassementSelect').focus();
        });

        // Validation du formulaire avant soumission
        document.querySelector('form').addEventListener('submit', function(e) {
            const requiredFields = [
                'Objet',
                'DateReception',
                'CategorieCourrierId',
                'ModeEnvoiId',
                'NatureCourrierId',
                'CorrespondantId',
                'ServiceId'
            ];
            
            let isValid = true;
            let errorMessage = '';
            
            requiredFields.forEach(field => {
                const element = document.querySelector(`[name="${field}"]`);
                if (element && !element.value) {
                    isValid = false;
                    errorMessage = `Le champ "${element.previousElementSibling?.textContent || field}" est requis.`;
                }
            });
            
            if (!isValid) {
                e.preventDefault();
                alert(errorMessage);
            }
        });
    </script>
}