@model JconsultGC.Models.CourrierCreateViewModel

@{
    ViewData["Title"] = "Saisir un courrier";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<div class="container mt-4">
    <h2>Saisir un courrier entrant</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="OrdreNumero"></label>
                    <input asp-for="OrdreNumero" class="form-control" readonly placeholder="Généré automatiquement" />
                    <small class="form-text text-muted">Numéro généré automatiquement</small>
                </div>

                <div class="form-group">
                    <label asp-for="RegistreNumero"></label>
                    <input asp-for="RegistreNumero" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="ReferenceNumero"></label>
                    <input asp-for="ReferenceNumero" class="form-control" placeholder="RF-06-06" />
                </div>

                <div class="form-group">
                    <label asp-for="Objet">Objet</label>
                    <input asp-for="Objet" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="DateReception"></label>
                    <input asp-for="DateReception" class="form-control" type="date" />
                </div>

                <div class="form-group">
                    <label asp-for="HeureRecu"></label>
                    <input asp-for="HeureRecu" class="form-control" type="time" />
                </div>

                <div class="form-group mb-3">
                    <label>Catégorie</label>
                    <div class="d-flex gap-2 align-items-center">
                        <select asp-for="CategorieCourrierId" class="form-control">
                            <option value=""></option>
                            @foreach (var categorie in Model.AvailableCategories)
                            {
                                <option value="@categorie.Id">@categorie.Nom</option>
                            }
                        </select>
                        <button type="button" class="btn btn-primary" id="btnAddCategorie">
                            <i class="bi bi-plus-circle"></i> Nouveau
                        </button>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label>Mode d'envoi</label>
                    <div class="d-flex gap-2 align-items-center">
                        <select asp-for="ModeEnvoiId" class="form-control" id="ModeEnvoiId">
                            <option value=""></option>
                            @foreach (var mode in Model.AvailableModesEnvoi)
                            {
                                <option value="@mode.Id">@mode.Nom</option>
                            }
                        </select>
                        <button type="button" class="btn btn-primary" id="btnAddModeEnvoi">
                            <i class="bi bi-plus-circle"></i> Nouveau
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Confidentialité</label>
                    <select asp-for="Confidentialite" class="form-control">
                        <option value="0">Public</option>
                        <option value="1">Interne</option>
                        <option value="2">Confidentiel</option>
                        <option value="3">Très confidentiel</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Priorité</label>
                    <select asp-for="Priorite" class="form-control">
                        <option value="0">Basse</option>
                        <option value="1">Normal</option>
                        <option value="2">Haute</option>
                        <option value="3">Urgent</option>
                    </select>
                </div>

            </div>

            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label>Nature</label>
                    <div class="d-flex gap-2 align-items-center">
                        <select asp-for="NatureCourrierId" class="form-control">
                            <option value=""></option>
                            @foreach (var nature in Model.AvailableNatures)
                            {
                                <option value="@nature.Id">@nature.Nom</option>
                            }
                        </select>
                        <button type="button" class="btn btn-primary" id="btnAddNature">
                            <i class="bi bi-plus-circle"></i> Nouveau
                        </button>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label>Type de dossier</label>
                    <div class="d-flex gap-2 align-items-center">
                        <select asp-for="TypeDossierId" class="form-control">
                            <option value=""></option>
                            @foreach (var type in Model.AvailableTypeDossiers)
                            {
                                <option value="@type.Id">@type.Nom</option>
                            }
                        </select>
                        <button type="button" class="btn btn-primary" id="btnAddTypeDossier">
                            <i class="bi bi-plus-circle"></i> Nouveau
                        </button>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label>Dossier de classement</label>
                    <div class="d-flex gap-2 align-items-center">
                        <select asp-for="DossierClassementId" class="form-control" id="dossierClassementSelect">
                            <option value=""></option>
                            @foreach (var dossier in Model.AvailableDossiers)
                            {
                                <option value="@dossier.Id">@dossier.Nom</option>
                            }
                        </select>
                        <button type="button" class="btn btn-primary" id="btnAddDossierClassement">
                            <i class="bi bi-plus-circle"></i> Nouveau
                        </button>
                    </div>
                    
                    <!-- Affichage du dossier sélectionné -->
                    <div id="selectedDossierDisplay" class="mt-2 p-2 border rounded bg-light" style="display: none;">
                        <h6>Dossier sélectionné :</h6>
                        <div id="dossierNom" class="fw-bold"></div>
                        <div id="dossierDetails" class="text-muted small"></div>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="visualizedCheckbox" />
                            <label class="form-check-label" for="visualizedCheckbox">J'ai visualisé le dossier sélectionné</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Service concerné</label>
                    <select asp-for="ServiceConcerne" class="form-control" id="ServiceConcerne">
                        <option value=""></option>
                        @if (Model.AvailableServices != null && Model.AvailableServices.Any())
                        {
                            @foreach (var service in Model.AvailableServices)
                            {
                                <option value="@service.Nom">@service.Nom</option>
                            }
                        }
                        else
                        {
                            <option value="">Aucun service disponible</option>
                        }
                    </select>
                    @if (Model.AvailableServices != null)
                    {
                        <small class="form-text text-muted">@Model.AvailableServices.Count services disponibles</small>
                    }
                </div>

                <div class="form-group">
                    <label asp-for="UtilisateursEnCopie"></label>
                    <input asp-for="UtilisateursEnCopie" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label>Expéditeur</label>
                    <div class="d-flex gap-2 align-items-center">
                        <select asp-for="CorrespondantId" class="form-control">
                            <option value=""></option>
                            @foreach (var correspondant in Model.AvailableCorrespondants)
                            {
                                <option value="@correspondant.Id">@correspondant.Nom</option>
                            }
                        </select>
                        <button type="button" class="btn btn-primary" id="btnAddCorrespondant">
                            <i class="bi bi-plus-circle"></i> Nouveau
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Service destinataire</label>
                    <select asp-for="ServiceId" class="form-control" id="ServiceId">
                        <option value=""></option>
                        @if (Model.AvailableServices != null && Model.AvailableServices.Any())
                        {
                            @foreach (var service in Model.AvailableServices)
                            {
                                <option value="@service.Id">@service.Nom</option>
                            }
                        }
                        else
                        {
                            <option value="">Aucun service disponible</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Pièces jointes</label>
                    <input type="file" name="Attachments" multiple class="form-control" id="fileInput" />
                    <small class="form-text text-muted">Vous pouvez scanner le dossier puis sélectionner les fichiers ici.</small>
                    <div class="mt-2">
                        <button type="button" class="btn btn-secondary" id="btnScan">Scanner le dossier</button>
                        <button type="button" class="btn btn-secondary" id="btnSelect">Sélectionner le dossier</button>
                    </div>
                </div>

                <!-- Section pour visualiser un fichier sélectionné -->
                <div class="form-group mt-3">
                    <label>Sélectionner un fichier à visualiser</label>
                    <input type="file" class="form-control" id="fileViewerInput" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.txt" />
                    <small class="form-text text-muted">Sélectionnez un fichier pour le visualiser avant de l'attacher.</small>
                    
                    <!-- Zone d'affichage du fichier -->
                    <div id="filePreviewArea" class="mt-3" style="display: none;">
                        <h6>Aperçu du fichier :</h6>
                        <div id="filePreview" class="border rounded p-3 bg-light">
                            <div id="fileInfo" class="mb-2"></div>
                            <div id="fileContent"></div>
                        </div>
                    </div>
                    
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="fileViewedCheckbox" />
                        <label class="form-check-label" for="fileViewedCheckbox">J'ai visualisé le fichier sélectionné</label>
                    </div>
                </div>

            </div>
        </div>

        <!-- Buttons positioned at the bottom of the form -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-primary" id="submitBtn">Enregistrer</button>
                    <a asp-action="Dashboard" class="btn btn-secondary">Retour</a>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Inclusion de tous les modaux -->
@await Html.PartialAsync("_AllModals")

<style>
    #submitBtn {
        position: relative;
        z-index: 1000;
        cursor: pointer;
    }
</style>

@section Scripts {
    <script>
        // Gestion de l'affichage du dossier sélectionné (optionnel)
        $(document).ready(function() {
            const dossierSelect = document.getElementById('dossierClassementSelect');
            const dossierDisplay = document.getElementById('selectedDossierDisplay');
            const dossierNom = document.getElementById('dossierNom');
            const dossierDetails = document.getElementById('dossierDetails');

            if (dossierSelect && dossierDisplay) {
                dossierSelect.addEventListener('change', function() {
                    const selectedOption = this.options[this.selectedIndex];
                    
                    if (this.value) {
                        dossierNom.textContent = selectedOption.text;
                        dossierDetails.textContent = `Dossier ID: ${this.value}`;
                        dossierDisplay.style.display = 'block';
                    } else {
                        dossierDisplay.style.display = 'none';
                    }
                });

                // Initialiser l'affichage si un dossier est déjà sélectionné
                if (dossierSelect.value) {
                    const selectedOption = dossierSelect.options[dossierSelect.selectedIndex];
                    dossierNom.textContent = selectedOption.text;
                    dossierDetails.textContent = `Dossier ID: ${dossierSelect.value}`;
                    dossierDisplay.style.display = 'block';
                }
            }
        });

        // Gestion du nouveau mode d'envoi
        document.getElementById('btnAddModeEnvoi').addEventListener('click', function() {
            const modal = new bootstrap.Modal(document.getElementById('modeEnvoiModal'));
            modal.show();
        });

        // Gestion du nouveau correspondant
        document.getElementById('btnAddCorrespondant').addEventListener('click', function() {
            const modal = new bootstrap.Modal(document.getElementById('correspondantModal'));
            modal.show();
        });

        // Gestion de la nouvelle catégorie
        document.getElementById('btnAddCategorie').addEventListener('click', function() {
            const modal = new bootstrap.Modal(document.getElementById('categorieModal'));
            modal.show();
        });

        // Gestion de la nouvelle nature
        document.getElementById('btnAddNature').addEventListener('click', function() {
            const modal = new bootstrap.Modal(document.getElementById('natureModal'));
            modal.show();
        });

        // Gestion du nouveau type de dossier
        document.getElementById('btnAddTypeDossier').addEventListener('click', function() {
            const modal = new bootstrap.Modal(document.getElementById('typeDossierModal'));
            modal.show();
        });

        // Gestion du nouveau dossier de classement
        document.getElementById('btnAddDossierClassement').addEventListener('click', function() {
            const modal = new bootstrap.Modal(document.getElementById('dossierClassementModal'));
            modal.show();
        });

        // Focus the file input when user clicks the Select button
        document.getElementById('btnSelect').addEventListener('click', function () {
            document.querySelector('input[type=file][name=Attachments]').click();
        });

        document.getElementById('btnScan').addEventListener('click', function () {
            alert('Fonction de scan non-implémentée dans le navigateur. Connectez un scanner ou utilisez l\'application mobile pour scanner et uploader les fichiers.');
        });

        const fileInput = document.getElementById('fileInput');
        const fileViewerInput = document.getElementById('fileViewerInput');
        const fileViewedCheckbox = document.getElementById('fileViewedCheckbox');
        const visualizedCheckbox = document.getElementById('visualizedCheckbox');

        // Gestion de la sélection de fichier pour visualisation
        fileViewerInput.addEventListener('change', function (e) {
            const files = Array.from(fileViewerInput.files || []);
            const filePreviewArea = document.getElementById('filePreviewArea');
            const fileInfo = document.getElementById('fileInfo');
            const fileContent = document.getElementById('fileContent');
            
            if (files.length === 0) {
                filePreviewArea.style.display = 'none';
                fileViewedCheckbox.checked = false;
                return;
            }

            const file = files[0];
            
            // Afficher les informations du fichier
            fileInfo.innerHTML = `
                <strong>Nom:</strong> ${file.name}<br>
                <strong>Taille:</strong> ${(file.size / 1024).toFixed(2)} KB<br>
                <strong>Type:</strong> ${file.type || 'Non spécifié'}
            `;
            
            // Afficher le contenu selon le type de fichier
            fileContent.innerHTML = '';
            
            if (file.type.startsWith('image/')) {
                // Afficher l'image
                const reader = new FileReader();
                reader.onload = function(e) {
                    fileContent.innerHTML = `<img src="${e.target.result}" class="img-fluid" style="max-height: 300px;" alt="Aperçu de l'image">`;
                };
                reader.readAsDataURL(file);
            } else if (file.type === 'application/pdf') {
                // Afficher un aperçu PDF
                const reader = new FileReader();
                reader.onload = function(e) {
                    fileContent.innerHTML = `
                        <div class="alert alert-info">
                            <i class="bi bi-file-earmark-pdf"></i> Fichier PDF sélectionné
                            <br><small>Le fichier sera téléchargé lors de l'enregistrement</small>
                        </div>
                        <iframe src="${e.target.result}" width="100%" height="400" style="border: 1px solid #ddd;"></iframe>
                    `;
                };
                reader.readAsDataURL(file);
            } else if (file.type.includes('text/') || file.name.endsWith('.txt')) {
                // Afficher le contenu texte
                const reader = new FileReader();
                reader.onload = function(e) {
                    fileContent.innerHTML = `<pre class="bg-white p-2 border rounded">${e.target.result}</pre>`;
                };
                reader.readAsText(file);
            } else {
                // Pour les autres types de fichiers
                fileContent.innerHTML = `
                    <div class="alert alert-warning">
                        <i class="bi bi-file-earmark"></i> Type de fichier: ${file.type || 'Inconnu'}
                        <br><small>Le fichier sera téléchargé lors de l'enregistrement</small>
                    </div>
                `;
            }
            
            // Afficher la zone d'aperçu
            filePreviewArea.style.display = 'block';
            
            // Cocher automatiquement la case de visualisation
            fileViewedCheckbox.checked = true;
        });

        // When files are selected for attachments
        fileInput.addEventListener('change', function (e) {
            const files = Array.from(fileInput.files || []);
            console.log('Fichiers sélectionnés:', files.length);
        });

        // Gestion du bouton Sélectionner dossier
        document.getElementById('btnSelectDossier').addEventListener('click', function() {
            // Simuler un clic sur le sélecteur de dossier
            document.getElementById('dossierClassementSelect').focus();
        });

        // Test simple pour vérifier que le bouton Enregistrer fonctionne
        document.getElementById('submitBtn').addEventListener('click', function(e) {
            console.log('Bouton Enregistrer cliqué !');
            // Laisser le formulaire se soumettre normalement
        });

        // Validation du formulaire avant soumission - Désactivée temporairement pour tests
        // document.querySelector('form').addEventListener('submit', function(e) {
        //     const requiredFields = [
        //         'Objet',
        //         'DateReception',
        //         'CategorieCourrierId',
        //         'ModeEnvoiId',
        //         'NatureCourrierId',
        //         'CorrespondantId',
        //         'ServiceId'
        //     ];
        //
        //     let isValid = true;
        //     let errorMessage = '';
        //
        //     requiredFields.forEach(field => {
        //         const element = document.querySelector(`[name="${field}"]`);
        //         if (element && !element.value) {
        //             isValid = false;
        //             errorMessage = `Le champ "${element.previousElementSibling?.textContent || field}" est requis.`;
        //         }
        //     });
        //
        //     if (!isValid) {
        //         e.preventDefault();
        //         alert(errorMessage);
        //     }
        // });
    </script>
}