@model IEnumerable<JconsultGC.Models.Service>

@{
    ViewData["Title"] = "Gestion des Services";
}

<div class="container mt-4">
    <h2>Gestion des Services</h2>

    <p>
        <a asp-action="CreateService" class="btn btn-primary">Créer un Nouveau Service</a>
    </p>

    <table class="table">
        <thead>
            <tr>
                <th>Nom du Service</th>
                <th>Code</th>
                <th>Responsable</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var service in Model)
            {
                <tr>
                    <td>@service.Nom</td>
                    <td>@service.Code</td>
                    <td>@service.Responsable</td>
                    <td>
                        <a asp-action="EditService" asp-route-id="@service.Id" class="btn btn-info btn-sm">Modifier</a>
                        <form asp-action="DeleteService" asp-route-id="@service.Id" method="post" style="display: inline;">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce service?');">
                                Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>