<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JconsultGC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JconsultGC.styles.css" asp-append-version="true" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">JconsultGC</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Administration
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Tableau de Bord</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">Gestion Utilisateurs</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Services">Gestion Services</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Indexateur"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="indexateurDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Indexateur
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="indexateurDropdown">
                                    <li><a class="dropdown-item" asp-controller="Indexateur" asp-action="Dashboard">Tableau de Bord</a></li>
                                    <li><a class="dropdown-item" asp-controller="Indexateur" asp-action="Create">Nouveau Courrier</a></li>
                                    <li><a class="dropdown-item" asp-controller="Indexateur" asp-action="ToValidate">À Valider</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Indexateur" asp-action="Index">Tous les Courriers</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Viseur"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="viseurDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Viseur
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="viseurDropdown">
                                    <li><a class="dropdown-item" asp-controller="Viseur" asp-action="Dashboard">Tableau de Bord</a></li>
                                    <li><a class="dropdown-item" asp-controller="Validation" asp-action="Index">Validation des Courriers</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Indexateur" asp-action="Index">Tous les Courriers</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("ServiceExpéditeur"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="serviceDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Service
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="serviceDropdown">
                                    <li><a class="dropdown-item" asp-controller="Service" asp-action="Dashboard">Tableau de Bord</a></li>
                                    <li><a class="dropdown-item" asp-controller="Service" asp-action="Courriers">Mes Courriers</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Indexateur" asp-action="Index">Tous les Courriers</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - JconsultGC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- IMask -->
    <script src="https://unpkg.com/imask"></script>
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- jQuery Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
