@model List<JconsultGC.Models.Courrier>

@{
    ViewData["Title"] = "Courriers du Service";
}

<div class="container mt-4">
    <h2>Courriers assignés au service</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0">Liste des courriers</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>N° d'ordre</th>
                                <th>Objet</th>
                                <th>Expéditeur</th>
                                <th>Catégorie</th>
                                <th>Date</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var courrier in Model)
                            {
                                <tr>
                                    <td>@courrier.OrdreNumero</td>
                                    <td>@courrier.Objet</td>
                                    <td>@(courrier.Correspondant?.Nom ?? "Inconnu")</td>
                                    <td>@(courrier.CategorieCourrier?.Nom ?? "Non catégorisé")</td>
                                    <td>@courrier.DateEnregistrement.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @switch (courrier.Statut)
                                        {
                                            case "Assigné":
                                                <span class="badge bg-warning">Assigné</span>
                                                break;
                                            case "En traitement":
                                                <span class="badge bg-info">En traitement</span>
                                                break;
                                            case "Traité":
                                                <span class="badge bg-success">Traité</span>
                                                break;
                                            case "Signé":
                                                <span class="badge bg-primary">Signé</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@courrier.Statut</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Details", "Service", new { id = courrier.Id })" 
                                               class="btn btn-sm btn-outline-primary" title="Détails">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            
                                            @if (courrier.Statut == "Assigné")
                                            {
                                                <form method="post" action="@Url.Action("CommencerTraitement", "Service", new { id = courrier.Id })" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Commencer le traitement">
                                                        <i class="bi bi-play-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                            
                                            @if (courrier.Statut == "En traitement")
                                            {
                                                <a href="@Url.Action("Details", "Service", new { id = courrier.Id })" 
                                                   class="btn btn-sm btn-outline-success" title="Terminer le traitement">
                                                    <i class="bi bi-check-circle"></i>
                                                </a>
                                            }
                                            
                                            @if (courrier.Statut == "Traité")
                                            {
                                                <a href="@Url.Action("Signer", "Service", new { id = courrier.Id })" 
                                                   class="btn btn-sm btn-outline-info" title="Signer">
                                                    <i class="bi bi-pen"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox display-1"></i>
                    <h4>Aucun courrier assigné</h4>
                    <p>Les courriers assignés à votre service apparaîtront ici.</p>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Dashboard" asp-controller="Service" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour au tableau de bord
        </a>
    </div>
</div>

@section Scripts {
    <script>
        // Confirmation pour commencer le traitement
        document.querySelectorAll('form[action*="CommencerTraitement"]').forEach(form => {
            form.addEventListener('submit', function(e) {
                if (!confirm('Êtes-vous sûr de vouloir commencer le traitement de ce courrier ?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}