@model JconsultGC.Controllers.ServiceDashboardViewModel

@{
    ViewData["Title"] = "Tableau de bord Service";
}

@functions {
    public string GetStatusBadgeClass(string statut)
    {
        return statut switch
        {
            "Assigné" => "bg-warning",
            "En traitement" => "bg-info",
            "Traité" => "bg-success",
            "Signé" => "bg-primary",
            _ => "bg-secondary"
        };
    }
}

<div class="container mt-4">
    <h2>Tableau de bord Service</h2>

    <div class="row mt-4">
        <!-- Stats Cards -->
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <h5 class="card-title">Assignés</h5>
                    <a href="@Url.Action("Courriers", "Service")" class="text-dark text-decoration-none">
                        <p class="card-text display-4">@Model.CourriersAssignesCount</p>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">En traitement</h5>
                    <p class="card-text display-4">@Model.CourriersEnTraitementCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Traités aujourd'hui</h5>
                    <p class="card-text display-4">@Model.CourriersTraitesAujourdhui</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Signés aujourd'hui</h5>
                    <p class="card-text display-4">@Model.CourriersSignesAujourdhui</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <!-- Actions récentes -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Mes actions d'aujourd'hui</h5>
                    <small class="text-muted">@DateTime.Today.ToString("dd/MM/yyyy")</small>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @if (Model.RecentActions.Any())
                        {
                            @foreach (var action in Model.RecentActions)
                            {
                                <a href="@Url.Action("Details", "Service", new { id = action.CourrierId })" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@action.Action</h6>
                                        <small>@action.Timestamp.ToString("HH:mm")</small>
                                    </div>
                                    <p class="mb-1">@action.Note</p>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="list-group-item text-center text-muted">
                                Aucune action aujourd'hui
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Courriers assignés récents -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Courriers assignés récents</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @if (Model.CourriersAssignes.Any())
                        {
                            @foreach (var courrier in Model.CourriersAssignes)
                            {
                                <a href="@Url.Action("Details", "Service", new { id = courrier.Id })" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@courrier.OrdreNumero</h6>
                                        <small>@courrier.DateEnregistrement.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <p class="mb-1">@courrier.Objet</p>
                                    <small>
                                        <span class="badge @GetStatusBadgeClass(courrier.Statut)">@courrier.Statut</span>
                                        - @(courrier.CategorieCourrier?.Nom ?? "Non catégorisé")
                                        - Expéditeur: @(courrier.Correspondant?.Nom ?? "Inconnu")
                                    </small>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="list-group-item text-center text-muted">
                                Aucun courrier assigné
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <!-- Actions rapides -->
        <div class="col-12">
            <div class="d-flex gap-2">
                <a asp-action="Courriers" asp-controller="Service" class="btn btn-warning">
                    <i class="bi bi-list-check"></i> Voir tous les courriers
                </a>
                <button type="button" class="btn btn-outline-primary" onclick="refreshDashboard()">
                    <i class="bi bi-arrow-clockwise"></i> Actualiser
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Actualiser manuellement
        function refreshDashboard() {
            location.reload();
        }
    </script>
}