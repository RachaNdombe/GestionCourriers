@model IEnumerable<Courrier>
@{
    ViewData["Title"] = "Recherche dans les archives";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Critères de recherche</h5>
        </div>
        <div class="card-body">
            <form method="get" action="@Url.Action("Recherche")">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="searchTerm" class="form-label">Terme de recherche</label>
                            <input type="text" class="form-control" id="searchTerm" name="searchTerm" 
                                   value="@ViewBag.SearchTerm" placeholder="Rechercher par référence, objet, correspondant...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label for="dateDebut" class="form-label">Date de début</label>
                            <input type="date" class="form-control" id="dateDebut" name="dateDebut" 
                                   value="@(ViewBag.DateDebut?.ToString("yyyy-MM-dd"))">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label for="dateFin" class="form-label">Date de fin</label>
                            <input type="date" class="form-control" id="dateFin" name="dateFin" 
                                   value="@(ViewBag.DateFin?.ToString("yyyy-MM-dd"))">
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Rechercher
                    </button>
                    <a href="@Url.Action("Recherche")" class="btn btn-outline-secondary">Effacer</a>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null)
    {
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Résultats de la recherche (@Model.Count() courrier(s) trouvé(s))</h5>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Référence</th>
                                    <th>Objet</th>
                                    <th>Date réception</th>
                                    <th>Correspondant</th>
                                    <th>Service concerné</th>
                                    <th>Créé par</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var courrier in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@courrier.ReferenceNumero</strong>
                                        </td>
                                        <td>@courrier.Objet</td>
                                        <td>@courrier.DateReception?.ToString("dd/MM/yyyy")</td>
                                        <td>@courrier.Correspondant?.Nom</td>
                                        <td>@courrier.ServiceConcerne</td>
                                        <td>@courrier.CreatedBy?.Nom @courrier.CreatedBy?.Prenom</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="@Url.Action("Details", new { id = courrier.Id })" 
                                                   class="btn btn-outline-primary" title="Détails">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                @if (User.IsInRole("Archivage"))
                                                {
                                                    <form method="post" action="@Url.Action("Restaurer", new { id = courrier.Id })" 
                                                          class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir restaurer ce courrier ?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-warning" title="Restaurer">
                                                            <i class="fas fa-undo"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">Aucun résultat trouvé</h5>
                        <p class="text-muted">Aucun courrier ne correspond à vos critères de recherche.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.table').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json'
                },
                pageLength: 25,
                order: [[2, 'desc']]
            });
        });
    </script>
}