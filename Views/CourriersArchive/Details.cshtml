@model Courrier

@{
    ViewData["Title"] = "Détails du courrier archivé";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
            @if (User.IsInRole("Archivage"))
            {
                <form method="post" action="@Url.Action("Restaurer", new { id = Model.Id })" 
                      class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir restaurer ce courrier ?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-undo"></i> Restaurer
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Informations du courrier</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>Référence:</dt>
                                <dd>@Model.ReferenceNumero</dd>

                                <dt>Objet:</dt>
                                <dd>@Model.Objet</dd>

                                <dt>Date de réception:</dt>
                                <dd>@Model.DateReception?.ToString("dd/MM/yyyy")</dd>

                                <dt>Heure de réception:</dt>
                                <dd>@Model.HeureRecu</dd>

                                <dt>Nature:</dt>
                                <dd>@Model.NatureCourrier?.Nom</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Correspondant:</dt>
                                <dd>@Model.Correspondant?.Nom</dd>

                                <dt>Service concerné:</dt>
                                <dd>@Model.ServiceConcerne</dd>

                                <dt>Catégorie:</dt>
                                <dd>@Model.CategorieCourrier?.Nom</dd>

                                <dt>Dossier de classement:</dt>
                                <dd>@Model.DossierClassement?.Titre</dd>

                                <dt>Créé par:</dt>
                                <dd>@Model.CreatedBy?.Nom @Model.CreatedBy?.Prenom</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Documents != null && Model.Documents.Any())
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Documents associés</h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group">
                            @foreach (var document in Model.Documents)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="fas fa-file-pdf text-danger me-2"></i>
                                            <span>@document.NomFichier</span>
                                        </div>
                                        <small class="text-muted">@document.Taille bytes</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Statut</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-archive me-2"></i>
                        <strong>Archivé</strong>
                        <br>
                        <small class="text-muted">Ce courrier est actuellement archivé</small>
                    </div>

                    <dl>
                        <dt>Date d'enregistrement:</dt>
                        <dd>@Model.DateEnregistrement.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt>Confidentialité:</dt>
                        <dd>
                            @switch (Model.Confidentialite)
                            {
                                case ConfidentialiteLevel.Public:
                                    <span class="badge bg-success">Public</span>
                                    break;
                                case ConfidentialiteLevel.Interne:
                                    <span class="badge bg-info">Interne</span>
                                    break;
                                case ConfidentialiteLevel.Confidentiel:
                                    <span class="badge bg-warning">Confidentiel</span>
                                    break;
                                case ConfidentialiteLevel.TresConfidentiel:
                                    <span class="badge bg-danger">Très confidentiel</span>
                                    break;
                            }
                        </dd>

                        <dt>Priorité:</dt>
                        <dd>
                            @switch (Model.Priorite)
                            {
                                case PrioriteLevel.Basse:
                                    <span class="badge bg-secondary">Basse</span>
                                    break;
                                case PrioriteLevel.Normal:
                                    <span class="badge bg-primary">Normale</span>
                                    break;
                                case PrioriteLevel.Haute:
                                    <span class="badge bg-warning">Haute</span>
                                    break;
                                case PrioriteLevel.Urgent:
                                    <span class="badge bg-danger">Urgente</span>
                                    break;
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>