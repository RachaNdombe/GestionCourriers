@model JconsultGC.Models.Courrier

@{
    ViewData["Title"] = "Détails du courrier archivé";
}

<div class="container mt-4">
    <h2>Détails du courrier archivé</h2>
    
    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Informations du courrier</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">N° d'ordre:</dt>
                        <dd class="col-sm-8">@Model.OrdreNumero</dd>

                        <dt class="col-sm-4">Objet:</dt>
                        <dd class="col-sm-8">@Model.Objet</dd>

                        <dt class="col-sm-4">Expéditeur:</dt>
                        <dd class="col-sm-8">@(Model.Correspondant?.Nom ?? "N/A")</dd>

                        <dt class="col-sm-4">Catégorie:</dt>
                        <dd class="col-sm-8">@(Model.CategorieCourrier?.Nom ?? "N/A")</dd>

                        <dt class="col-sm-4">Nature:</dt>
                        <dd class="col-sm-8">@(Model.NatureCourrier?.Nom ?? "N/A")</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Mode d'envoi:</dt>
                        <dd class="col-sm-8">@(Model.ModeEnvoi?.Libelle ?? "N/A")</dd>

                        <dt class="col-sm-4">Date enregistrement:</dt>
                        <dd class="col-sm-8">@Model.DateEnregistrement.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4">Statut:</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsArchive)
                            {
                                <span class="badge bg-success">Archivé</span>
                            }
                            else if (Model.Statut == "Signé")
                            {
                                <span class="badge bg-warning">Signé (en attente d'archivage)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">En cours</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Informations supplémentaires -->
            @if (!string.IsNullOrEmpty(Model.ReferenceNumero))
            {
                <div class="row mt-3">
                    <div class="col-12">
                        <dt>Référence:</dt>
                        <dd>@Model.ReferenceNumero</dd>
                    </div>
                </div>
            }

            <!-- Actions -->
            <div class="row mt-4">
                <div class="col-12">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Retour à la liste
                    </a>
                    <a asp-action="Dashboard" class="btn btn-primary">
                        <i class="bi bi-speedometer2"></i> Tableau de bord
                    </a>
                    @if (!Model.IsArchive && User.IsInRole("Archiviste"))
                    {
                        <form asp-action="Archiver" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success" 
                                    onclick="return confirm('Êtes-vous sûr de vouloir archiver ce courrier ?')">
                                <i class="bi bi-archive"></i> Archiver
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>