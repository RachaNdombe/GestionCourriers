@model IEnumerable<JconsultGC.Models.Courrier>

@{
    ViewData["Title"] = "Archives des courriers";
}

<div class="container mt-4">
    <h2>Archives des courriers</h2>
    
    <!-- Statistiques -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total archives</h5>
                    <h2 class="card-text">@Model.Count()</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Archivés aujourd'hui</h5>
                    <h2 class="card-text">@Model.Count(c => c.IsArchive && c.DateEnregistrement.Date == DateTime.Today)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Archivés ce mois</h5>
                    <h2 class="card-text">@Model.Count(c => c.IsArchive && c.DateEnregistrement.Month == DateTime.Now.Month && c.DateEnregistrement.Year == DateTime.Now.Year)</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    <a asp-action="Dashboard" class="btn btn-primary">
                        <i class="bi bi-speedometer2"></i> Tableau de bord
                    </a>
                    <a asp-action="Recherche" class="btn btn-secondary">
                        <i class="bi bi-search"></i> Recherche avancée
                    </a>
                    <a asp-action="Stats" class="btn btn-info">
                        <i class="bi bi-graph-up"></i> Statistiques
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Liste des archives -->
    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Liste des courriers archivés</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>N° d'ordre</th>
                                <th>Objet</th>
                                <th>Expéditeur</th>
                                <th>Catégorie</th>
                                <th>Nature</th>
                                <th>Date enregistrement</th>
                                <th>Date archivage</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var courrier in Model)
                            {
                                <tr>
                                    <td>@courrier.OrdreNumero</td>
                                    <td>@courrier.Objet</td>
                                    <td>@(courrier.Correspondant?.Nom ?? "N/A")</td>
                                    <td>@(courrier.CategorieCourrier?.Nom ?? "N/A")</td>
                                    <td>@(courrier.NatureCourrier?.Nom ?? "N/A")</td>
                                    <td>@courrier.DateEnregistrement.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(courrier.IsArchive ? courrier.DateEnregistrement.ToString("dd/MM/yyyy HH:mm") : "N/A")</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@courrier.Id" class="btn btn-sm btn-info" title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Aucun courrier archivé pour le moment.
                </div>
            }
        </div>
    </div>
</div>