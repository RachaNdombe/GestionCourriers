@model IEnumerable<Courrier>

@{
    ViewData["Title"] = "Courriers Archivés";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>
        <div>
            <a href="@Url.Action("Recherche")" class="btn btn-outline-primary">
                <i class="fas fa-search"></i> Recherche avancée
            </a>
            @if (User.IsInRole("Archivage") || User.IsInRole("Admin"))
            {
                <a href="@Url.Action("Stats")" class="btn btn-outline-info">
                    <i class="fas fa-chart-bar"></i> Statistiques
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Liste des courriers archivés</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Objet</th>
                                <th>Date réception</th>
                                <th>Correspondant</th>
                                <th>Service concerné</th>
                                <th>Créé par</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var courrier in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@courrier.ReferenceNumero</strong>
                                    </td>
                                    <td>@courrier.Objet</td>
                                    <td>@courrier.DateReception?.ToString("dd/MM/yyyy")</td>
                                    <td>@courrier.Correspondant?.Nom</td>
                                    <td>@courrier.ServiceConcerne</td>
                                    <td>@courrier.CreatedBy?.Nom @courrier.CreatedBy?.Prenom</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", new { id = courrier.Id })" 
                                               class="btn btn-outline-primary" title="Détails">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Archivage"))
                                            {
                                                <form method="post" action="@Url.Action("Restaurer", new { id = courrier.Id })" 
                                                      class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir restaurer ce courrier ?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-warning" title="Restaurer">
                                                        <i class="fas fa-undo"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-archive fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">Aucun courrier archivé</h5>
                    <p class="text-muted">Les courriers archivés apparaîtront ici.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.table').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json'
                },
                pageLength: 25,
                order: [[2, 'desc']]
            });
        });
    </script>
}